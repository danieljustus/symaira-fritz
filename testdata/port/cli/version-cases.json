{
  "schema_version": 1,
  "oracle": "Go symfritz built with version=dev",
  "environment": {
    "HOME": "isolated temporary directory",
    "LC_ALL": "C",
    "LANG": "C",
    "TZ": "UTC",
    "SYMFRITZ_*": "unset"
  },
  "cases": [
    {
      "id": "version-text",
      "args": [
        "version"
      ],
      "exit_code": 0,
      "stdout": "symfritz dev\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-flag",
      "args": [
        "--version"
      ],
      "exit_code": 0,
      "stdout": "symfritz version dev\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-json-output",
      "args": [
        "version",
        "--output",
        "json"
      ],
      "exit_code": 0,
      "stdout": "{\"tool\":\"symfritz\",\"version\":\"dev\",\"schema_version\":1}\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-json-flag",
      "args": [
        "version",
        "--json"
      ],
      "exit_code": 0,
      "stdout": "{\"tool\":\"symfritz\",\"version\":\"dev\",\"schema_version\":1}\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-json-case-insensitive",
      "args": [
        "version",
        "--output",
        "JSON"
      ],
      "exit_code": 0,
      "stdout": "{\"tool\":\"symfritz\",\"version\":\"dev\",\"schema_version\":1}\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-yaml",
      "args": [
        "version",
        "--output",
        "yaml"
      ],
      "exit_code": 0,
      "stdout": "schema_version: 1\ntool: symfritz\nversion: dev\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-extra-argument",
      "args": [
        "version",
        "extra"
      ],
      "exit_code": 0,
      "stdout": "symfritz dev\n",
      "stderr": "",
      "comparison": "bytes"
    },
    {
      "id": "version-invalid-output",
      "args": [
        "--output",
        "wat",
        "version"
      ],
      "exit_code": 9,
      "stdout": "",
      "stderr": "Error: invalid output format: unsupported output format \"wat\" (want text, json, or yaml)\n",
      "comparison": "bytes"
    },
    {
      "id": "version-conflicting-output",
      "args": [
        "version",
        "--json",
        "--output",
        "yaml"
      ],
      "exit_code": 9,
      "stdout": "",
      "stderr": "Error: conflicting output formats: conflicting output formats \"yaml\" and \"json\"\n",
      "comparison": "bytes"
    }
  ]
}
