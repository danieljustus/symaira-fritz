{
  "schema_version": 1,
  "oracle": "Go internal/secret production functions",
  "credential_cases": [
    {
      "id": "env-wins-over-all",
      "description": "SYMFRITZ_PASSWORD environment variable takes precedence over symvault, keychain, and config",
      "env_password": "from-env-secret",
      "ref": "fritz.password",
      "keychain": true,
      "keychain_account": "fritz.box",
      "plaintext": "from-plaintext",
      "mock_vault_pass": "from-vault",
      "mock_keychain_pass": "from-keychain",
      "expected_pass": "from-env-secret",
      "expected_source": "env"
    },
    {
      "id": "symvault-wins-over-keychain-and-plaintext",
      "description": "password_ref takes precedence over keychain and plaintext",
      "ref": "fritz.password",
      "keychain": true,
      "keychain_account": "fritz.box",
      "plaintext": "from-plaintext",
      "mock_vault_pass": "from-vault",
      "mock_keychain_pass": "from-keychain",
      "expected_pass": "from-vault",
      "expected_source": "symvault"
    },
    {
      "id": "symvault-error-stops-without-fallback",
      "description": "symvault failure must return error immediately and fail closed without falling through",
      "ref": "fritz.password",
      "keychain": true,
      "keychain_account": "fritz.box",
      "plaintext": "should-never-be-used",
      "mock_vault_err": "vault is locked",
      "mock_keychain_pass": "from-keychain",
      "expected_pass": "",
      "expected_source": "",
      "expected_error": "symvault get \"fritz.password\": vault is locked"
    },
    {
      "id": "keychain-wins-over-plaintext",
      "description": "keychain takes precedence over plaintext fallback",
      "keychain": true,
      "keychain_account": "fritz.box",
      "plaintext": "from-plaintext",
      "mock_keychain_pass": "from-keychain",
      "expected_pass": "from-keychain",
      "expected_source": "keychain"
    },
    {
      "id": "keychain-error-stops-without-fallback",
      "description": "keychain lookup failure must return error immediately and fail closed without falling through",
      "keychain": true,
      "keychain_account": "fritz.box",
      "plaintext": "should-never-be-used",
      "mock_keychain_err": "security: item not found",
      "expected_pass": "",
      "expected_source": "",
      "expected_error": "keychain lookup: security: item not found"
    },
    {
      "id": "plaintext-fallback",
      "description": "plaintext config password is used when env, symvault and keychain are not configured",
      "keychain": false,
      "plaintext": "plain-config-password",
      "expected_pass": "plain-config-password",
      "expected_source": "config"
    },
    {
      "id": "nothing-configured",
      "description": "returns empty password with none source when no credentials are configured",
      "keychain": false,
      "expected_pass": "",
      "expected_source": "none"
    }
  ],
  "subprocess_contracts": [
    {
      "id": "symvault-get",
      "description": "symvault get reads secret from stdout, never passing secret in argv",
      "executable": "symvault",
      "args": [
        "get",
        "{ref}",
        "--print"
      ],
      "stdin_payload": "",
      "exposes_secret_in_argv": false
    },
    {
      "id": "symvault-set",
      "description": "symvault set receives secret over stdin with trailing newline, never in argv",
      "executable": "symvault",
      "args": [
        "set",
        "{ref}",
        "--stdin-value"
      ],
      "stdin_payload": "{value}\n",
      "exposes_secret_in_argv": false
    },
    {
      "id": "keychain-get-with-account",
      "description": "security find-generic-password with service and account",
      "executable": "security",
      "args": [
        "find-generic-password",
        "-s",
        "symfritz",
        "-w",
        "-a",
        "{account}"
      ],
      "stdin_payload": "",
      "exposes_secret_in_argv": false
    },
    {
      "id": "keychain-get-without-account",
      "description": "security find-generic-password with service only",
      "executable": "security",
      "args": [
        "find-generic-password",
        "-s",
        "symfritz",
        "-w"
      ],
      "stdin_payload": "",
      "exposes_secret_in_argv": false
    },
    {
      "id": "keychain-set-with-account",
      "description": "security interactive mode receives a hex-encoded add-generic-password command over stdin, never in argv",
      "executable": "security",
      "args": [
        "-i",
        "-q"
      ],
      "stdin_payload": "add-generic-password -U -s \"symfritz\" -a \"{account}\" -X 7b76616c75657d\n",
      "exposes_secret_in_argv": false
    },
    {
      "id": "keychain-set-without-account",
      "description": "security interactive mode stores a hex-encoded password without an account",
      "executable": "security",
      "args": [
        "-i",
        "-q"
      ],
      "stdin_payload": "add-generic-password -U -s \"symfritz\" -X 7b76616c75657d\n",
      "exposes_secret_in_argv": false
    }
  ]
}
