  "harness": {
    "help_flag_overrides": [
      {
        "id": "CAP-WLAN-ADVERTISED-INDEX",
        "paths": [
          "symfritz wlan",
          "symfritz wlan clients",
          "symfritz wlan guest",
          "symfritz wlan guest off",
          "symfritz wlan guest on",
          "symfritz wlan guest status",
          "symfritz wlan radios"
        ],
        "flag": "--guest-index",
        "oracle": {
          "default": "3",
          "description": "WLANConfiguration index of the guest radio"
        },
        "candidate": {
          "default": null,
          "description": "WLANConfiguration index of the guest radio (default: highest index the box advertises)"
        },
        "test": "symfritz-tr064/tests/remaining_capabilities.rs::guest_wlan_index_follows_the_box_instead_of_assuming_three"
      }
    ],
    "request_trace_overrides": [
