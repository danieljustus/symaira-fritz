        "NewText": "A\u0026B\"quoted\""
      }
    },
    {
      "id": "nested-values-follow-go-state-machine",
      "action": "GetInfo",
      "xml": "\u003cGetInfoResponse\u003e\u003cOuter\u003ebefore\u003cInner\u003einside\u003c/Inner\u003eafter\u003c/Outer\u003e\u003c/GetInfoResponse\u003e",
