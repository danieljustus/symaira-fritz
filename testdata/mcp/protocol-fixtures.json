      "request": "Content-Length: 51\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":\"list\",\"method\":\"tools/list\"}",
      "response": {
        "jsonrpc": "2.0",
        "id": "list",
        "result": {
          "tools": [
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "FRITZ!Box overview: model, firmware, connection state, external IP.",
              "inputSchema": {
                "properties": {},
                "type": "object"
              },
              "name": "status"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "List devices in the FRITZ!Box host table (name, IP, MAC, active, LAN/WLAN).",
              "inputSchema": {
                "properties": {
                  "active_only": {
                    "description": "Only return currently active hosts",
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "name": "host_list"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "Look up one host by name, MAC, or IP. Provide exactly one of name/mac/ip.",
