                "properties": {
                  "ip": {
                    "type": "string"
                  },
                  "mac": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "name": "host_get"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "End-to-end reachability check for a host (name/MAC/IP): known to box, active, LAN/WLAN, DNS, and TCP ports (default 22/5900/8001).",
              "inputSchema": {
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "ports": {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "host"
                ],
                "type": "object"
              },
              "name": "diagnose"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "Mesh topology: nodes (box, repeaters, clients) and the links between them.",
              "inputSchema": {
                "properties": {},
                "type": "object"
              },
              "name": "mesh"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "List devices associated with the WLAN radios (MAC, IP, signal, speed).",
              "inputSchema": {
                "properties": {},
                "type": "object"
              },
              "name": "wlan_clients"
            },
            {
              "annotations": {
                "openWorldHint": true
              },
              "description": "Send a Wake-on-LAN packet via the box. Provide host (name/IP, resolved via host table) or mac.",
              "inputSchema": {
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "mac": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "name": "wake_on_lan"
            },
            {
              "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
              },
              "description": "List DECT smart-home actors (switches, thermostats) with AIN, name, and state.",
              "inputSchema": {
                "properties": {},
                "type": "object"
              },
              "name": "home_list"
            },
            {
              "annotations": {
                "openWorldHint": true
              },
              "description": "Turn a DECT switch actor on or off by its AIN.",
              "inputSchema": {
                "properties": {
                  "ain": {
                    "type": "string"
                  },
                  "on": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ain",
                  "on"
                ],
                "type": "object"
              },
              "name": "home_switch"
            }
          ]
        }
      }
