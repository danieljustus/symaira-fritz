    {
      "name": "initialize",
      "request": "Content-Length: 46\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}",
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "tools": {}
          },
          "instructions": "Query and control an AVM FRITZ!Box: connection status, the LAN/WLAN host table, mesh topology, WLAN clients, and DECT smart-home actors. For 'is host X reachable' questions use diagnose. Use host_list to find a device's MAC/IP before wake_on_lan or home_switch.",
          "protocolVersion": "2024-11-05",
          "serverInfo": {
            "name": "symfritz",
            "version": "dev"
          }
        }
      }
    },
    {
